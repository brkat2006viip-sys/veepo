# Telegram bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Fernet key for encrypting user API keys (generate with utils/commands)
FERNET_KEY=replace_with_generated_fernet_key

# DB path (sqlite)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Optional: AgentRouter API base url (example)
AGENTROUTER_API_URL=https://api.agentrouter.example

# Host/Port for webhook mode (optional)
WEBHOOK_HOST=
WEBHOOK_PORT=8443
